# Copia este archivo como services/api/.env (ignorado por Git) y completa tus credenciales.
# Ninguna de estas variables llega al cliente: solo las lee FastAPI al arrancar.

# Clima complementario (opcional). Sin esto, la ruta responde "unavailable" y la comparación sigue.
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# Redacción de la explicación con Groq (opcional). Crea la clave en https://console.groq.com/keys
# Sin clave, la explicación la escribe el propio backend con sus reglas.
GROQ_API_KEY=
# Modelo con salida estructurada (json_schema) y razonamiento. Si lo dejas vacío se usa openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-120b
# Cuánto razona el modelo antes de responder: low, medium o high. Más alto tarda más y gasta más tokens.
GROQ_REASONING_EFFORT=high
